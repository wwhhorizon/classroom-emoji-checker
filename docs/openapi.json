  "components": {
    "schemas": {
      "AIResult": {
        "properties": {
          "session_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Session Id"
          },
          "emoji": {
            "type": "string",
            "enum": [
              "happy",
              "neutral",
              "sad",
              "surprised",
              "angry",
              "fearful",
              "disgusted"
            ],
            "title": "Emoji"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "device_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Device Id"
          },
          "event_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Event Id"
          },
          "model_version": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Model Version"
          },
          "user_id": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "User Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "emoji",
          "confidence",
          "timestamp",
          "device_id",
          "event_id",
          "model_version"
        ],
        "title": "AIResult"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualEmoji": {
        "properties": {
          "session_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Session Id"
          },
          "emoji": {
            "type": "string",
            "enum": [
              "happy",
              "neutral",
              "sad",
              "surprised",
              "angry",
              "fearful",
              "disgusted"
            ],
            "title": "Emoji"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "emoji"
        ],
        "title": "ManualEmoji"
      },
      "NewCourse": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "teacher_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Teacher Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "teacher_id"
        ],
        "title": "NewCourse"
      },
      "NewSession": {
        "properties": {
          "course_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Course Id"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          },
          "class_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Class Name"
          },
          "room": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Room"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "course_id",
          "start_at",
          "end_at",
          "class_name",
          "room"
        ],
        "title": "NewSession"
      },
      "Password": {
        "properties": {
          "old_password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Old Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 64,
            "minLength": 10,
            "title": "New Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "old_password",
          "new_password"
        ],
        "title": "Password"
      },
      "Register": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 2,
            "pattern": "^[\\w.-]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 1,
            "title": "Password"
          },
          "role": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "admin"
            ],
            "title": "Role",
            "default": "student"
          },
          "email": {
            "type": "string",
            "maxLength": 120,
            "title": "Email",
            "default": ""
          },
          "invite_code": {
            "type": "string",
            "maxLength": 128,
            "title": "Invite Code",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Register"
      },
      "Schedule": {
        "properties": {
          "user_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 500,
            "title": "User Ids"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_ids",
          "version"
        ],
        "title": "Schedule"
      },
      "UpdateSession": {
        "properties": {
          "course_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Course Id"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "title": "End At"
          },
          "class_name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Class Name"
          },
          "room": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Room"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "course_id",
          "start_at",
          "end_at",
          "class_name",
          "room",
          "version"
        ],
        "title": "UpdateSession"
      },
      "UserStatus": {
        "properties": {
          "active": {
            "type": "boolean",
            "title": "Active"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "active"
        ],
        "title": "UserStatus"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "emoji_session"
      },
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "用户登录返回的access_token"
      },
      "AIServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "独立AI_SERVICE_TOKEN，不接受用户令牌"
      }
    }
  }
